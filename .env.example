# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional: Your numeric Telegram User ID as fallback (leave empty by default)
OWNER_ID=

# Optional: Private Telegram Channel ID for permanent media backup (e.g. -1001234567890)
BACKUP_CHANNEL_ID=

# Optional: Set to true on cloud hosting with low disk space (e.g. Render) to delete local temp media after uploading
CLEANUP_TEMP_MEDIA=false
